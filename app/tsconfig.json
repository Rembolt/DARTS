{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "react": [
        "../node_modules/preact/compat"
      ],
      "react/jsx-runtime": [
        "../node_modules/preact/jsx-runtime"
      ],
      "react-dom": [
        "../node_modules/preact/compat"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "proxy-target.ts",
    "proxy-target.test.ts"
  ]
}